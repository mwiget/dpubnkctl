#==============================================================================
#  bf.conf — NON-LAG TEMPLATE  (rendered by dpubnkctl from bf-nolag.conf.tmpl)
#
#  Each physical uplink (p0, p1) sits on its own OVS bridge:
#     p0 → sf-external
#     p1 → sf-internal
#  No bonding, no LAG. VLANs declare their uplink to pick the bridge.
#==============================================================================

UPDATE_DPU_OS="yes"
ubuntu_PASSWORD='{{.PasswordHash}}'
MTU={{.DPUMtu}}

bfb_modify_os()
{
    local hname="{{.Hostname}}"
    echo ${hname} > /mnt/etc/hostname
    echo "127.0.0.1 ${hname}" >> /mnt/etc/hosts

    cat << EOFNET > /mnt/etc/cloud/cloud.cfg.d/99-disable-network-config.cfg
network: {config: disabled}
EOFNET

    cat << EOFMGMT > /mnt/etc/netplan/50-mgmt.yaml
network:
  renderer: networkd
  ethernets:
    tmfifo_net0:
      dhcp4: false
      addresses:
        - {{.TmfifoIP}}
    oob_net0:
      dhcp4: true
      dhcp6: true
  version: 2
EOFMGMT
    chmod 600 /mnt/etc/netplan/50-mgmt.yaml

    # Install operator's SSH pubkey so dpubnkctl can SSH to the DPU
    # without sshpass/password handling after first boot.
    mkdir -p /mnt/home/ubuntu/.ssh
    cat <<'EOFSSH' > /mnt/home/ubuntu/.ssh/authorized_keys
{{.OperatorPubkey}}
EOFSSH
    chmod 700 /mnt/home/ubuntu/.ssh
    chmod 600 /mnt/home/ubuntu/.ssh/authorized_keys
    chown -R 1000:1000 /mnt/home/ubuntu/.ssh

    # Generate sshd host keys at flash time. The BFB image ships with
    # /var/lib/cloud/instances/nocloud/ pre-populated from NVIDIA's
    # image build, so cloud-init's cc_ssh module sees "Instance link
    # already exists, not recreating it" and skips key generation
    # on first boot. The fallback (ssh-keygen.service / sshd-internal
    # auto-regen) is racy and not all BSP boots fire it — sometimes
    # sshd starts and exits with "no hostkeys available -- exiting"
    # in a tight restart loop. Baking the keys at install time
    # eliminates the race. ssh-keygen -A is idempotent.
    chroot /mnt /usr/bin/ssh-keygen -A

    cat << EOFRESOLVE > /mnt/etc/systemd/resolved.conf
[Resolve]
DNS={{.DNSServers}}
Domains={{.DNSDomains}}
FallbackDNS=
DNSStubListener=yes
EOFRESOLVE

    cat << EOFTIMESYNC > /mnt/etc/systemd/timesyncd.conf
[Time]
NTP={{.NTPServers}}
EOFTIMESYNC

    cat << EOFMODULES >> /mnt/etc/modules-load.d/custom.conf
overlay
br_netfilter
vfio_pci
mst_pci
EOFMODULES

    cat << EOFSYSCTL >> /mnt/etc/sysctl.d/kubernetes.conf
net.bridge.bridge-nf-call-ip6tables = 1
net.bridge.bridge-nf-call-iptables = 1
net.ipv4.ip_forward = 1
EOFSYSCTL

    local grub_cmd="console=hvc0 console=ttyAMA0 earlycon=pl011,0x13010000 fixrttc net.ifnames=0 biosdevname=0 iommu.passthrough=1 cgroup_no_v1=net_prio,net_cls default_hugepagesz=2MB hugepagesz=2M hugepages=8192"
    sed -i -E "s|^(GRUB_CMDLINE_LINUX=\")(.*)\"|\1${grub_cmd}\"|" /mnt/etc/default/grub
    ilog "$(chroot /mnt env PATH=$PATH /usr/sbin/grub-mkconfig -o /boot/grub/grub.cfg)"

    rm -f /mnt/etc/mellanox/mlnx-sf.conf
    for pciid in $(lspci -nD 2> /dev/null | grep 15b3:a2d[26c] | awk '{print $1}')
        do
            cat << EOFSF >> /mnt/etc/mellanox/mlnx-sf.conf
/sbin/mlnx-sf --action create --device $pciid --sfnum 1 --enable-trust --hwaddr $(uuidgen | sed -e 's/-//;s/^\(..\)\(..\)\(..\)\(..\)\(..\).*$/02:\1:\2:\3:\4:\5/')
EOFSF
        done

    # Two OVS bridges, one per uplink.
    cat <<EOFOVS > /mnt/etc/mellanox/mlnx-ovs.conf
CREATE_OVS_BRIDGES="yes"
OVS_BRIDGE1="sf-external"
OVS_BRIDGE1_PORTS="p0 pf0hpf en3f0pf0sf1"
OVS_BRIDGE2="sf-internal"
OVS_BRIDGE2_PORTS="p1 pf1hpf en3f1pf1sf1"
OVS_HW_OFFLOAD="yes"
EOFOVS

    if [ -f /mnt/etc/mellanox/mlnx-bf.conf ]; then
        sed -i '/^LAG_HASH_MODE=/d' /mnt/etc/mellanox/mlnx-bf.conf
    fi

    cat << EOFNETPLAN > /mnt/etc/netplan/70-bf-nolag.yaml
network:
  renderer: networkd
  ethernets:
    p0:
      mtu: "$MTU"
      dhcp4: no
      optional: true
    p1:
      mtu: "$MTU"
      dhcp4: no
      optional: true
  version: 2
EOFNETPLAN
    chmod 600 /mnt/etc/netplan/70-bf-nolag.yaml

# --- Persist OVS VLAN config via systemd oneshot ---
cat > /mnt/usr/local/sbin/ovs-vlan-init.sh <<'EOS'
#!/usr/bin/env bash
set -euo pipefail

MTU={{.DPUMtu}}

for i in $(seq 1 60); do
  ovs-vsctl --timeout=2 show >/dev/null 2>&1 && break
  sleep 1
done

# Bring OVS internal ports up to the physical uplink's MTU. Without this
# they default to 1500 even when p0/p1 are 9000 — caps the bridge's
# effective MTU and breaks anything larger than 1500 across the host
# PCIe path (pf0hpf/pf1hpf).
ip link set sf-external mtu $MTU || true
ip link set sf-internal mtu $MTU || true
ip link set pf0hpf mtu $MTU || true
ip link set pf1hpf mtu $MTU || true
{{range $i, $vlan := .VLANs}}
# vlan {{$i}} — uplink {{$vlan.Uplink}}
ovs-vsctl --may-exist add-port {{if eq $vlan.Uplink "p1"}}sf-internal{{else}}sf-external{{end}} {{$vlan.Name}} -- set interface {{$vlan.Name}} type=internal
ovs-vsctl set port {{$vlan.Name}} tag={{$vlan.Tag}}
ip link set {{$vlan.Name}} mtu $MTU
ip link set {{$vlan.Name}} up
ip addr replace {{$vlan.IP}} dev {{$vlan.Name}}
{{- if $vlan.DefaultGateway}}
ip route replace default via {{$vlan.DefaultGateway}} dev {{$vlan.Name}}
{{- end}}
{{end}}
EOS

chmod 755 /mnt/usr/local/sbin/ovs-vlan-init.sh

cat > /mnt/etc/systemd/system/ovs-vlan-init.service <<'EOS'
[Unit]
Description=Configure OVS VLAN trunks and internal VLAN interfaces
After=openvswitch-switch.service
Wants=openvswitch-switch.service
StartLimitInterval=0

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ovs-vlan-init.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
EOS

mkdir -p /mnt/etc/systemd/system/multi-user.target.wants
ln -sf /etc/systemd/system/ovs-vlan-init.service \
  /mnt/etc/systemd/system/multi-user.target.wants/ovs-vlan-init.service

    ln -sf /dev/null /mnt/etc/systemd/system/dnsmasq.service

echo 'RUN_FW_UPDATER_ONBOOT=yes' >> /mnt/etc/infiniband/openib.conf

    cat << EOFCLOUDINIT >> /mnt/var/lib/cloud/seed/nocloud-net/user-data
write_files:
  - path: /var/tmp/setup-script.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      systemctl stop containerd kubelet kubepods.slice
      rm -rf /var/lib/containerd/*
      rm -rf /run/containerd/*
      rm -f /usr/lib/systemd/system/kubelet.service.d/90-kubelet-bluefield.conf
      systemctl daemon-reload
runcmd:
  - [ /var/tmp/setup-script.sh ]
EOFCLOUDINIT
}

bfb_post_install()
{
    log ===================== bfb_post_install =====================
    mst start
    mst_device=$(/bin/ls /dev/mst/mt*pciconf0 2> /dev/null)
    log "Setting SF enable, BAR size, and non-LAG mode for $mst_device"
    for mst_device in /dev/mst/mt*pciconf*
    do
      mlxconfig -y -d $mst_device s PF_BAR2_ENABLE=0 PER_PF_NUM_SF=1 PF_TOTAL_SF=20 PF_SF_BAR_SIZE=10 NUM_OF_VFS=46 HIDE_PORT2_PF=False NUM_OF_PF=2 LAG_RESOURCE_ALLOCATION=DEVICE_DEFAULT INTERNAL_CPU_OFFLOAD_ENGINE=0 INTERNAL_CPU_MODEL=1
      mlxprivhost -d $mst_device p  # disable Zero-Trust Mode
    done
}
